{
  "packageManager": "npm",
  "testRunner": "mocha",
  "reporters": [
    "progress",
    "clear-text",
    "html"
  ],
  "coverageAnalysis": "perTest",
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 60
  },
  "mutate": [
    "src/**/*.js",
    "!src/xslint.js",
    "!src/logger.js",
    "!src/output.js"
  ],
  "mochaOptions": {
    "spec": [
      "test/**/*.test.js"
    ]
  }
}
